<Application x:Class="DeadAge2JP.Patcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <!-- 起動処理（インストール検出など）は App.xaml.cs の OnStartup で行うため StartupUri は指定しない -->
    <Application.Resources>
        <!-- 配色: 暗めの背景にゲームの雰囲気に合う赤系のアクセント -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FF16181B" />
        <SolidColorBrush x:Key="CardBackground" Color="#FF202327" />
        <SolidColorBrush x:Key="CardBorder" Color="#FF30343A" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFECEDEE" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FF9AA0A6" />
        <SolidColorBrush x:Key="Accent" Color="#FFB3261E" />
        <SolidColorBrush x:Key="AccentHover" Color="#FFCF3A31" />
        <SolidColorBrush x:Key="AccentDisabled" Color="#FF4A3534" />
        <SolidColorBrush x:Key="StatusGood" Color="#FF5FBF7A" />
        <SolidColorBrush x:Key="StatusWarn" Color="#FFE0A33C" />
        <SolidColorBrush x:Key="StatusNeutral" Color="#FF9AA0A6" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <!-- 適用済みの間は変更できないことが分かるよう薄く表示する -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 主ボタン（日本語化する／元に戻す） -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{StaticResource Accent}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentDisabled}" />
                                <Setter Property="Foreground" Value="#FF8A8F94" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- リンク風の小さなボタン -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextDecorations="Underline" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
