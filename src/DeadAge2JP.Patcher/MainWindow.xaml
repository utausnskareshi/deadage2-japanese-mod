<Window x:Class="DeadAge2JP.Patcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dead Age 2 日本語化パッチ"
        Width="600"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,4,16,4" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,24,28,20">
        <!-- 見出し -->
        <TextBlock Text="Dead Age 2" FontSize="28" FontWeight="Bold" />
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="日本語化パッチ（非公式・有志制作）" Foreground="{StaticResource TextSecondary}" />
            <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource TextSecondary}" Margin="10,0,0,0" />
        </StackPanel>

        <!-- 検出したゲームと状態 -->
        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                CornerRadius="6" Padding="18,12" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="インストール先" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding GameDir}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="ゲームのビルド" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding BuildText}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="状態" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding StatusText}"
                           Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="翻訳" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding TranslationText}" />
            </Grid>
        </Border>

        <TextBlock Text="{Binding NoticeText}" Foreground="{StaticResource StatusWarn}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />

        <!-- 主ボタン（日本語化する／元に戻す） -->
        <Button Style="{StaticResource PrimaryButton}" Content="{Binding ButtonText}" Command="{Binding ToggleCommand}" Margin="0,18,0,0" />

        <StackPanel Margin="0,10,0,0" IsEnabled="{Binding CanChangeOptions}">
            <CheckBox IsChecked="{Binding UseJapaneseFont}" Content="日本語フォント（BIZ UDPゴシック）で表示する" />
            <CheckBox IsChecked="{Binding SwitchLanguage}" Content="ゲームの言語設定を自動で「日本語 (JA)」に切り替える" />
        </StackPanel>

        <!-- 進捗 -->
        <ProgressBar Height="6" Margin="0,16,0,0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                     Foreground="{StaticResource Accent}" Background="{StaticResource CardBorder}" BorderThickness="0" />
        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap" />

        <!-- ログ -->
        <Expander Header="詳細ログ" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,0">
            <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="170" Margin="0,6,0,0"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas, MS Gothic" FontSize="11"
                     Background="#FF101214" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource CardBorder}" />
        </Expander>

        <!-- フッター -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource LinkButton}" Content="ログフォルダを開く" Command="{Binding OpenLogFolderCommand}" />
            <Button Style="{StaticResource LinkButton}" Content="ライセンス" Command="{Binding OpenLicensesCommand}" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0"
                   Text="本ツールは有志による非公式の日本語化パッチで、開発元・販売元とは関係ありません。ゲームのファイルは配布せず、お使いの PC 上のファイルだけを書き換えます。「元に戻す」で適用前の状態に戻せます。" />
    </StackPanel>
</Window>
