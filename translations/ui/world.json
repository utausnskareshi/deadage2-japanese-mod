    "RankDescription_0": {
      "text": "クズの烙印を押された。結果: 戦争になる。",
      "source": "ae3a4b346d04e94b"
    },
    "RankDescription_1": {
      "text": "敵を作ってしまった。結果: 見張りや巡回するパトロールに警戒すること",
      "source": "4d01d14f682b2e07"
    },
    "RankDescription_2": {
      "text": "良くも悪くも、誰も気にかけていない",
      "source": "c9acd0f5a2cf9763"
    },
    "RankDescription_3": {
      "text": "おおむね受け入れられている。結果: 酒場でより実入りのいい仕事を受けられる",
      "source": "d353e8e0e4b08323"
    },
    "RankDescription_4": {
      "text": "高く評価されている。結果: {0}から軽装アーマーを購入でき、{1}にいるとき、ときどきパトロールの支援を受けられる。",
      "source": "7c9a04df6e815295"
    },
    "RankDescription_5": {
      "text": "称賛されている。結果: {0}から重装アーマーを購入でき、{1}にいるときはパトロールの支援を受けられる。",
      "source": "82ad594157ac9bf1"
    },
